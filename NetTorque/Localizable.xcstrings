    "Save Image…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz obrazek…"
          }
        }
      }
    },
    "See your wired link speed at a glance, and measure it in one click. The icon in the menu bar shows how fast the cable link is; the window copies data to a server and back and tells you how fast it really goes.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prędkość łącza kablowego widać od razu, a zmierzysz ją jednym kliknięciem. Ikonka na pasku menu pokazuje, jak szybkie jest łącze; okno kopiuje dane na serwer i z powrotem i mówi, ile naprawdę przechodzi."
          }
        }
      }
    },
    "Select All": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz wszystko"
          }
