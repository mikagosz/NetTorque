          "stringUnit": {
            "state": "translated",
            "value": "Cel"
          }
        }
      }
    },
    "Test": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Testuj"
          }
        }
      }
    },
    "Test runs a quick test with the last settings; the last result is shown under it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Testuj” robi szybki test z ostatnimi ustawieniami; pod spodem ostatni wynik."
          }
        }
      }
    },
    "Test starts it, Stop ends it at any moment. The test file is always removed on both sides.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Testuj” zaczyna, „Przerwij” kończy w każdej chwili. Plik testowy zawsze znika po obu stronach."
          }
        }
      }
    },
    "Test stopped — %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Test przerwany — %@"
          }
        }
      }
    },
