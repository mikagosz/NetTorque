    "SSH server, network folder (SMB, NFS) or another Mac running NetTorque.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer SSH, folder sieciowy (SMB, NFS) albo inny Mac z NetTorque."
